<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). -->
	<!-- Storage shared with the Files app extension (see SharedContainer.swift). -->
	<key>ArkenalAppGroup</key>
	<string>$(ARKENAL_APP_GROUP)</string>
	<key>ArkenalKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.snowlightlabs.arkenal</string>
	<key>NSCameraUsageDescription</key>
	<string>Arkenal uses the camera to scan documents to your NAS.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Arkenal finds and connects to your NAS on your home network.</string>
	<!-- Setup looks for NAS by their file sharing (SMB) announcement. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_smb._tcp</string>
	</array>
	<!-- iOS: audio keeps playing with the screen locked and video can float in
	     Picture in Picture (only while a player is open); "processing" runs Photo
	     Backup in the background, only with Back Up Automatically turned on. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>
	<!-- Photo Backup › Back Up Automatically (off unless turned on). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.snowlightlabs.Arkenal.backup</string>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Arkenal backs up your photos and videos to your NAS when you turn on Photo Backup.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Arkenal can use Face ID to unlock the app and your encrypted folders.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets HTTPS connections to local addresses (192.168.x.x, nas.local) proceed so
		     Arkenal's own certificate checks (CertificateTrust.swift) can decide. Plain
		     HTTP is never used. This exception doesn't require App Review justification. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Only standard HTTPS/TLS is used, which is exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
