<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Arkenal</string>
	<key>ArkenalAppGroup</key>
	<string>$(ARKENAL_APP_GROUP)</string>
	<key>ArkenalKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.snowlightlabs.arkenal</string>
	<!-- The Finder sidebar icon for the NAS location: the Arkenal mark as a
	     custom symbol (FileProvider/Assets.xcassets). -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleSymbolName</key>
			<string>ArkenalMark</string>
		</dict>
	</dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<!-- Finder's right-click menu. The rules read each item's userInfo
		     (FileProviderItem.swift): "kept" on the item itself, "insideKept"
		     also inside a kept folder. -->
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>com.snowlightlabs.arkenal.keepDownloaded</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Keep Downloaded</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0 AND SUBQUERY(fileproviderItems, $item, $item.userInfo.insideKept == YES).@count == 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>com.snowlightlabs.arkenal.stopKeepingDownloaded</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Stop Keeping Downloaded</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0 AND SUBQUERY(fileproviderItems, $item, $item.userInfo.kept == YES).@count == fileproviderItems.@count</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
